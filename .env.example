# 1) Isi kunci API Anthropic Anda (buat di https://console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# 2) (Opsional) Model bawaan. Bisa juga dipilih per tugas di layar ("Model tim").
#    Pilihan: claude-opus-5-5 (paling teliti) atau claude-sonnet-5-5 (lebih cepat & hemat)
# CLAUDE_MODEL=claude-opus-5-5          # untuk semua
# LEADER_MODEL=claude-opus-5-5          # khusus Pemimpin (mengalahkan CLAUDE_MODEL)
# WORKER_MODEL=claude-sonnet-5-5        # khusus 8 agent (mengalahkan CLAUDE_MODEL)

# 3) (Opsional) Kedalaman berpikir: low / medium / high / xhigh / max
# LEADER_EFFORT=high
# WORKER_EFFORT=medium
# PORT=3000

# ── Mode langganan (bawaan, tanpa biaya tambahan) ─────────────────────────────
# Tidak perlu API key. Cukup login akun Claude sekali:  npm run login  → ketik /login
# Biaya diambil dari kredit Agent SDK bulanan langganan (Pro $20, Max 5x $100, Max 20x $200).
# Klaim kredit itu sekali di akun Claude, dan JANGAN aktifkan "usage credits" agar
# tidak pernah ada tagihan tambahan (tugas berhenti bila kredit habis).

# Kata sandi aplikasi (min. 12 karakter). Wajib bila dibuka dari perangkat lain
# (HOST bukan 127.0.0.1, atau lewat Tailscale). Lihat deploy/HIVEOS.md.
# APP_PASSWORD=

# Rem pengaman per tugas (USD perkiraan). Tugas dihentikan bila mencapai angka ini.
# MAX_TASK_USD=3

# Jumlah tugas yang dikerjakan bersamaan (sisanya antre otomatis, maks. 10 antre).
# MAX_TUGAS_PARALEL=3

# Model bawaan (bisa juga dipilih per tugas di layar). Bawaan mode langganan = "Hemat otomatis":
# Pemimpin Sonnet (effort medium) dan 8 agent Sonnet.
# CLAUDE_MODEL=claude-sonnet-5-5        # untuk semua: claude-sonnet-5-5 / claude-opus-5-5
# LEADER_MODEL=claude-opus-5-5          # khusus Pemimpin
# WORKER_MODEL=claude-sonnet-5-5        # khusus 8 agent
# LIGHT_MODEL=claude-sonnet-5-5         # khusus agent ringan (Email & Kalender, Chrome & Portal); claude-haiku-5-5 = paling hemat

# Penghematan token (mode langganan)
# KNOWLEDGE_INLINE_CHARS=16000          # pengetahuan yang ditempel ke prompt per agent; sisanya dibaca bila perlu
# KONTEKS_MAKS_TOKEN=100000             # percakapan dipadatkan otomatis saat konteks mendekati angka ini (min. 100000)

# Alternatif login tanpa browser: jalankan `claude setup-token`, lalu isi token di sini.
# CLAUDE_CODE_OAUTH_TOKEN=

# Kedalaman berpikir: low / medium / high / xhigh / max
# LEADER_EFFORT=high                   # bawaan preset hemat: medium
# WORKER_EFFORT=medium
# PORT=3000

# ── Mode API (berbayar, opsional) ────────────────────────────────────────────
# Hanya dipakai bila ENGINE=api. Ditagih terpisah dari langganan.
# ENGINE=api
# ANTHROPIC_API_KEY=

# ── Mode langganan (bawaan, tanpa biaya tambahan) ─────────────────────────────
# Tidak perlu API key. Cukup login akun Claude sekali:  npm run login  → ketik /login
# Biaya diambil dari kredit Agent SDK bulanan langganan (Pro $20, Max 5x $100, Max 20x $200).
# Klaim kredit itu sekali di akun Claude, dan JANGAN aktifkan "usage credits" agar
# tidak pernah ada tagihan tambahan (tugas berhenti bila kredit habis).

# Rem pengaman per tugas (USD perkiraan). Tugas dihentikan bila mencapai angka ini.
# MAX_TASK_USD=3

# Model bawaan (bisa juga dipilih per tugas di layar). Mode langganan: Sonnet.
# CLAUDE_MODEL=claude-sonnet-5-5        # untuk semua: claude-sonnet-5-5 / claude-opus-5-5
# LEADER_MODEL=claude-opus-5-5          # khusus Pemimpin
# WORKER_MODEL=claude-sonnet-5-5        # khusus 8 agent

# Alternatif login tanpa browser: jalankan `claude setup-token`, lalu isi token di sini.
# CLAUDE_CODE_OAUTH_TOKEN=

# Kedalaman berpikir: low / medium / high / xhigh / max
# LEADER_EFFORT=high
# WORKER_EFFORT=medium
# PORT=3000

# ── Mode API (berbayar, opsional) ────────────────────────────────────────────
# Hanya dipakai bila ENGINE=api. Ditagih terpisah dari langganan.
# ENGINE=api
# ANTHROPIC_API_KEY=
